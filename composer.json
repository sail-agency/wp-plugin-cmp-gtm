{
  "name": "sail-agency/cmp-gtm",
  "description": "CMP Loader for GTM",
  "homepage": "https://github.com/sail-agency/wp-plugin-cmp-gtm",
  "authors": [
    {
      "name": "Are Kristoffer Lamo",
      "homepage": "https://sail.no/folk/are-kristoffer-lamo/"
    }
  ],
  "license": "proprietary",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4|>=8.0",
    "htmlburger/carbon-fields": "^3.6",
    "composer/installers": "^1.0 || ^2.0"
  },
  "autoload": {
    "psr-4": {
        "Sail\\CMP_GTM\\": "src/"
    }
},
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
  "i18n:pot": "wp i18n make-pot . languages/sail-cmp.pot --exclude=vendor,docker,wp_install --skip-js",
  "i18n:mo": "wp i18n make-mo languages",
  "i18n": ["@i18n:pot", "@i18n:mo"]
}
}
